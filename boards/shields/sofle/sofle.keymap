/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * PandaKB Sofle v1 MX (nice!nano-class Pro Micro nRF52840 controllers,
 * SSD1306 OLED on each half). Target project: zmk-config / shield `sofle`
 * — the build whose matrix wiring was verified against this physical board.
 *
 * Layers: 0 = BASE, 1 = AUX1, 2 = AUX2. M1 = momentary AUX1, M2 = momentary AUX2.
 * Holding M1+M2 together still reaches ADJUST (conditional layer) for BT/RGB.
 *
 * Encoders (BASE, AUX1 and AUX2 rotate the same way):
 *   left:  CW = volume up, CCW = volume down, push = mute
 *   right: CW = down arrow, CCW = up arrow (plain key presses, NOT mouse scroll),
 *          push = double left mouse click
 * On AUX1 the encoder pushes toggle each half's own OLED (left push -> left
 * screen, right push -> right screen, independent; no mute / double click).
 *
 * Encoder pushes live on matrix positions RC(4,5) (left half) and RC(4,6)
 * (right half) — the two slots flanking the center in the row-4 transform line.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define AUX1 1
#define AUX2 2
#define ADJUST 3

/* Double left mouse click: one physical press of the right encoder button
 * sends exactly two full clicks (each = press + release, 20 ms button-down),
 * with 80 ms between the clicks. Nothing is left held afterwards; holding the
 * button does not repeat the macro (it runs once per press). The timings are
 * set here: tap-ms = 20 (click duration), wait-ms = 80 (gap between clicks),
 * mirrored by the &macro_tap_time / &macro_wait_time control bindings. */
ZMK_MACRO(dbl_click,
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    tap-ms = <20>;
    wait-ms = <80>;
    bindings = <&macro_tap_time 20 &macro_wait_time 80 &macro_tap &mkp MB1 &mkp MB1>;
)

/ {

   // Activate ADJUST layer by pressing M1 and M2 together
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <AUX1 AUX2>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base";
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   | L-ENCPUSH  |  | R-ENCPUSH |  N  |  M    |  ,    |  .   |   /   |   \   |
//               |  [  | CTRL | ALT  | CMD  | SPACE  |  | ENTER | SHIFT |  M1  |  M2  |   ]   |
            bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                             &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
&kp ESC   &kp Q  &kp W  &kp E  &kp R  &kp T                              &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
&kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G                              &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE  &dbl_click       &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp BSLH
                  &kp LBRC &kp LCTRL &kp LALT &kp LGUI &kp SPACE  &kp RET &kp RSHFT &mo AUX1 &mo AUX2 &kp RBRC
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        aux1_layer {
            display-name = "aux1";
// Rotation same as BASE. Encoder pushes toggle the OLEDs:
// left push -> left screen, right push -> right screen (independent).
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
// |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
// |       |  =  |  -  |  +   |  {   |  }   | OLED-L  |  | OLED-R |  [   |  ]    |  ;    |  :   |   \   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&trans    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
&trans    &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                 &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC  &kp RBRC   &oled_toggle &oled_toggle  &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH  &trans
                    &trans    &trans      &trans    &trans     &trans &trans  &trans    &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        aux2_layer {
            display-name = "aux2";
// Rotation same as BASE. Encoder pushes are transparent here.
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
// |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
// |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  | DEL   | BKSPC |
// |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &trans  &trans
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans    &kp UP   &trans    &kp N0  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans        &trans  &trans  &trans    &trans    &trans   &trans    &trans  &trans
                        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        adjust_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            display-name = "adjust";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;
        };

    };
};
