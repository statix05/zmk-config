/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * Sofle v1 MX — clean-slate keymap (branch feat/sofle-clean).
 * Standard upstream layers BAS/AUX/RAI, 60 positions (58 + two pushes).
 * BT channels: 0/1/2 = Macs (BLE), 3 = USB bridge dongle, 4 spare.
 * Left encoder PCB is inverted: the (CW, CCW) params are swapped on purpose
 * so a physical CW turn yields volume UP. Right encoder is not inverted.
 * Encoder pushes: left = LALT, right = RET (all layers).
 * DYA runtime behaviors are registered and Studio-editable; defaults below
 * are plain runtime-sensor-rotate nodes (no browser-zoom overlay, no
 * display-sync, no custom OLED code — stock ZMK status screen only).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
/* Register the assignable DYA runtime behavior without changing any key. */
#include <behaviors/runtime_macro.dtsi>
#include "sofle-encoders.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";
            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   | L-ENCPUSH  |  | R-ENCPUSH  |  N  |  M    |  ,    |  .   |   /   |   \   |
            //               |  [  | CTRL | ALT  | CMD  | SPACE  |  | ENTER | SHIFT |  AUX  |  RAI  |   ]   |

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                   &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                                    &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                    &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B   &kp LALT      &kp RET     &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp BSLH
                   &kp LBRC  &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp RET  &kp RSHFT    &mo 1    &mo 2      &kp RBRC
            >;

            /* Left PCB inverted: first (CW) param is VOLUME_DOWN so physical
             * CW yields volume UP. Right encoder: CW = DOWN arrow. */
            sensor-bindings = <&rsr_volume &rsr_nav>;
        };

        lower_layer {
            display-name = "AUX";
            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | MO 2  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   | <-  |  v    |  ^    |  ->  | ⌘->   |   |   |
            // |       |  =  |  -  | KP+  |  {   |  }   | L-ENCPUSH  |  | R-ENCPUSH |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp GRAVE  &kp F1     &kp F2     &kp F3       &kp F4    &kp F5                       &kp F6     &kp F7    &kp F8           &kp F9     &kp F10   &kp F11
&mo 2      &kp N1     &kp N2     &kp N3       &kp N4    &kp N5                       &kp N6     &kp N7    &kp N8           &kp N9     &kp N0    &kp F12
&none      &kp LS(N1) &kp LS(N2) &kp LS(N3)   &kp LS(N4) &kp LS(N5)                  &kp LEFT   &kp DOWN  &kp UP           &kp RIGHT  &kp LG(RIGHT) &kp LS(BSLH)
&none      &kp EQUAL  &kp MINUS  &kp KP_PLUS  &kp LBRC  &kp RBRC   &kp LALT     &kp RET &kp LBRC &kp RBRC &kp SEMI &kp LS(SEMI) &kp BSLH &none
                      &none      &none        &none     &none      &none    &none  &none      &none     &none    &none
            >;

            sensor-bindings = <&rsr_volume &rsr_nav>;
        };

        raise_layer {
            display-name = "RAI";
            // BT channels: 0/1/2 = Macs, 3 = USB dongle bridge, 4 spare.
            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT0  | BT1  |  BT2  |  BT3  | BT4  |                | KP-  |  KP7  |  KP8  | KP9  | 9(    | 0)    |
            // |⌃␣   | INS  | PSCR | App   |       |      |                | KP+  |  KP4  |  KP5  | KP6  |  [{   | ]}    |
            // |     | ESC  | CTRL | SHIFT |       | CAPS |                | KP*  |  KP1  |  KP2  | KP3  |  ,<   | .>    |
            // |     |      |      |       |       |      | L-ENCPUSH |  | R-ENCPUSH | KP/  | Bksp  |  KP0  | Del  |  #    | ⌥\|   |
            //               |      |       |       |      |      |  |ENTER | ⇧    | KP=   |       | Tab  |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4                  &kp KP_MINUS  &kp KP_N7  &kp KP_N8   &kp KP_N9  &kp LS(N9) &kp LS(N0)
&kp LC(SPACE) &kp INS     &kp PSCRN     &kp K_CMENU    &none         &none                         &kp KP_PLUS   &kp KP_N4  &kp KP_N5   &kp KP_N6  &kp LBRC   &kp RBRC
&none       &kp ESC       &kp LCTRL     &kp LSHFT      &none         &kp CLCK                      &kp KP_ASTERISK &kp KP_N1 &kp KP_N2  &kp KP_N3  &kp COMMA  &kp DOT
&none       &none         &none         &none          &none         &none         &kp LALT    &kp RET &kp KP_DIVIDE &kp BSPC   &kp KP_N0   &kp DEL    &kp LS(N3) &kp LS(LA(BSLH))
                          &none         &none          &none         &none         &none  &kp RET  &kp RSHFT     &kp KP_EQUAL &none   &kp TAB
            >;

            sensor-bindings = <&rsr_volume &rsr_nav>;
        };
    };
};
