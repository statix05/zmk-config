            >;

            /* LEFT encoder inverted: on this PCB CW reads as CCW, so the
             * inc/dec params are swapped (CW = first param = C_VOL_DN here
             * would sound DOWN... this swap restores CW = volume UP).
             * RIGHT encoder works correctly: CW = DOWN arrow. */
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp DOWN UP>;
        };

        lower_layer {
            display-name = "AUX1";

