 *
 * PandaKB Sofle v1 MX. Layers (0..2): BAS, AUX1, RAI. Matches the keymap the
 * owner configured via DYA Studio (see Desktop screenshots), so a settings
 * reset before flashing is safe: the static keymap IS the current layout.
 *
 * Encoders (same rotation on all layers; LEFT inverted for the reversed PCB:
 * CW = volume up requires swapping inc/dec params):
 *   left:  CW = volume up, CCW = volume down, push = LALT (BASE), OLED toggle (AUX1), none (RAI)
 *   right: CW = down arrow, CCW = up arrow, push = double LMB click (BASE),
 *          OLED toggle (AUX1), none (RAI)
 *
 * Encoder pushes live on matrix positions RC(4,5) (left half) and RC(4,6)
 * (right half) — the two slots flanking the center in the row-4 transform.
 */

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Behavior to toggle the LOCAL half's OLED (driver compiled from repo root
 * module, src/oled_toggle.c). Locality EVENT_SOURCE: the behavior runs on the
 * half where the bound key physically lives, so each half toggles only its
 * own display. */

/ {
    behaviors {
        oled_toggle: behavior_oled_toggle {
            compatible = "zmk,behavior-oled-toggle";
            #binding-cells = <0>;
            display-name = "OLED Toggle";
        };

