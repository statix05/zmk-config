 * SPDX-License-Identifier: MIT
 *
 * PandaKB Sofle v1 MX. This is the keymap actually used by the build
 * (ZMK picks config/sofle.keymap from ZMK_CONFIG), layers:
 *   0 = BASE, 1 = AUX1 (LOW), 2 = AUX2 (RAI).
 *
 * Encoders (same rotation on all layers):
 *   left:  CW = volume up, CCW = volume down, push = mute
 *   right: CW = down arrow, CCW = up arrow (plain key presses, NOT mouse scroll),
 *          push = double left mouse click
 * On AUX1 the encoder pushes toggle each half's own OLED (left push -> left
 * screen, right push -> right screen, independent; no mute / double click).
 *
 * Encoder pushes live on matrix positions RC(4,5) (left half) and RC(4,6)
 * (right half) — the two slots flanking the center in the row-4 transform.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/* Behavior to toggle the LOCAL half's OLED (driver compiled from repo root
 * module, src/oled_toggle.c). Locality EVENT_SOURCE: the behavior runs on the
 * half where the bound key physically lives, so each half toggles only its
 * own display. */
/ {
    behaviors {
        oled_toggle: behavior_oled_toggle {
            compatible = "zmk,behavior-oled-toggle";
            #binding-cells = <0>;
            display-name = "OLED Toggle";
        };
    };
};


/* Double left mouse click: one physical press of the right encoder button
 * sends exactly two full clicks (each = press + release, 20 ms button-down),
 * with 80 ms between the clicks. Nothing is left held afterwards; holding the
 * button does not repeat the macro (it runs once per press). Timings:
 * tap-ms = 20 (click duration), wait-ms = 80 (gap between clicks). */
/ {
    behaviors {
        /* Double left mouse click: one physical press of the right encoder
         * button sends exactly two full clicks (each = press + release, 20 ms
         * button-down), with 80 ms between the clicks. Nothing is left held
         * afterwards; holding the button does not repeat the macro (it runs
         * once per press). Timings: tap-ms (click duration), wait-ms (gap). */
        dbl_click: dbl_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <80>;
            bindings = <&macro_tap_time 20 &macro_wait_time 80 &macro_tap &mkp MB1 &mkp MB1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";
            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   | L-ENCPUSH  |  | R-ENCPUSH  |  N  |  M    |  ,    |  .   |   /   |   \   |
            //               |  [  | CTRL | ALT  | CMD  | SPACE  |  | ENTER | SHIFT |  M1  |  M2  |   ]   |

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                   &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                                    &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                    &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B   &kp C_MUTE    &dbl_click  &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp BSLH
                   &kp LBRC  &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp RET  &kp RSHFT    &mo 1    &mo 2      &kp RBRC
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        lower_layer {
            display-name = "AUX1";
            // Rotation same as BASE. Encoder pushes toggle the OLEDs:
            // left push -> left screen, right push -> right screen (independent).
            // ------------------------------------------------------------------------------------------------------------
            // | `     |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | RAISE |   1 |   2 |  3   |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   | OLED-L  |  | OLED-R |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp GRAVE  &kp F1     &kp F2     &kp F3       &kp F4    &kp F5                       &kp F6     &kp F7    &kp F8           &kp F9     &kp F10   &kp F11
&mo 2      &kp N1     &kp N2     &kp N3       &kp N4    &kp N5                       &kp N6     &kp N7    &kp N8           &kp N9     &kp N0    &kp F12
&trans     &kp EXCL   &kp AT     &kp HASH     &kp DLLR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR   &kp RPAR  &kp PIPE
&trans     &kp EQUAL  &kp MINUS  &kp KP_PLUS  &kp LBRC  &kp RBRC   &oled_toggle    &oled_toggle  &kp LBKT   &kp RBKT  &kp SEMI         &kp COLON  &kp BSLH  &trans
                      &trans     &trans       &trans    &trans     &trans    &trans  &trans     &trans    &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        raise_layer {
            display-name = "RAI";
            // Rotation same as BASE. Encoder pushes are transparent here.
            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |     | INS  | PSCR | GUI   |       |      |                | PGUP |      |       |      |       |       |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                |  <-  |   v  |   ^   |  ->  |  DEL  | BKSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //              |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &trans    &trans  &trans     &trans   &trans
&trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans                          &kp PG_UP  &trans    &trans  &trans     &kp N0   &trans
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                        &kp LEFT   &kp DOWN  &kp UP  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &trans     &trans    &trans  &trans     &trans   &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans     &trans    &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };
    };
};
